
{
  "ConnectionStrings": {
    "Default": "Data Source=AppData/todo.db"
  },
  "Jwt": {
    "Issuer": "TodoApp",
    "Audience": "TodoAppClient",
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_64CHARS",
    "ExpMinutes": 120
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*"
}
